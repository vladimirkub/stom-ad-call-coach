# Server-side only. Never prefix with NEXT_PUBLIC_.
ELEVENLABS_API_KEY=
# Filled in by `npm run create-agent`
ELEVENLABS_AGENT_ID=
GEMINI_API_KEY=
# Optional: gemma-4-26b-a4b-it (default) or gemma-4-31b-it
GEMMA_MODEL=gemma-4-26b-a4b-it
# Optional: set to "off" for faster but less accurate evaluations
# GEMMA_JSON_THINKING=off

# Random string used to encrypt the CRM session cookie. Generate: openssl rand -hex 32
CRM_SESSION_SECRET=
