# Server-side only. Never prefix with NEXT_PUBLIC_.
ELEVENLABS_API_KEY=
# Filled in by `npm run create-agent`
ELEVENLABS_AGENT_ID=
GEMINI_API_KEY=
# Optional model overrides (needs a billed Gemini API project; the free tier stalls with several users):
# GEMINI_MODEL=gemini-3.5-flash-lite          live chat + checklist
# GEMINI_SMART_MODEL=gemini-3.6-flash         evaluation, model script, knowledge learning
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite used when the main model is overloaded
# Optional: "on" gives evaluations full thinking (slower, 10-30 s instead of 3-8 s)
# GEMINI_JSON_THINKING=on

# Random string used to encrypt the CRM session cookie. Generate: openssl rand -hex 32
CRM_SESSION_SECRET=
